# KRTD Font Craft Ultra — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# Add these same keys to your Vercel project settings.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional: cloud AI for the in-app Agent (server-side only, NEVER prefix with VITE_) ──
# Add in Vercel -> Settings -> Environment Variables, then Redeploy. Set ANY ONE (or several = automatic fallback).
# Without any key the Agent still works fully (local brain).
GEMINI_API_KEY=your-google-ai-studio-key      # best Sinhala/Unicode quality (tried first)
# GEMINI_MODEL=gemini-flash-latest
ZAI_API_KEY=your-z-ai-key                     # Z.AI GLM (OpenAI-compatible)
# ZAI_MODEL=glm-5.2
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ANTHROPIC_API_KEY=sk-ant-your-key             # Claude
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=auto                            # auto | gemini | zai | anthropic
